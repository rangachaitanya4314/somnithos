# =======================================================
# Somnithos Environment Configuration Template
# =======================================================
# Keep API keys server-side. Never expose keys in client code.
# Copy this file to .env and provide your actual API keys.

# Gemini API Key (Server-side reasoning & synthesis)
GEMINI_API_KEY=

# Imagen 3 / Generative Image Model API Key (Optional; defaults to GEMINI_API_KEY if shared)
IMAGEN_API_KEY=

# Server Port (Optional, defaults to 3001)
PORT=3001
